PORT=3000

# AI defaults
AI_DEFAULT_MODEL=modelscope:qwen3.5-27b
AI_REQUEST_TIMEOUT_MS=1200000
AI_MAX_OUTPUT_TOKENS=4096

# Ollama
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_TAGS_URL=http://127.0.0.1:11434/api/tags

# ModelScope
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1
MODELSCOPE_API_KEY=

# OpenAI-compatible provider
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Anthropic (optional, Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Security: local API only; restart backend after changes.
YANFU_BIND_HOST=127.0.0.1
# Trusted Live Server browser origins, comma separated. Defaults to localhost/127.0.0.1:5500-5501.
YANFU_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501
YANFU_API_MAX_REQUESTS_PER_MINUTE=240
YANFU_API_MAX_ACTIVE_AI_REQUESTS=3
# Optional: 32+ random characters for receipts that survive backend restart. Never commit real secrets.
# YANFU_REVIEW_ATTESTATION_SECRET=
