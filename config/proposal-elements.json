          "name": "salt",
          "type": "bytes32",
          "semantic": "create2-salt",
          "protected": true
        }
      ],
      "riskProfile": {
        "flatWeight": 45,
        "category": "deployment"
      },
      "pack": "Upgrade Pack",
      "contractType": "deployment",
      "analysisHints": [
        "Protected CREATE2 deployment. Preserve bytecode and salt exactly and treat deployment as high risk."
      ]
    },
    {
      "id": "governor.setVotingDelay",
      "label": "Set Voting Delay",
      "pack": "Governance Pack",
      "contractType": "governor-settings",
      "contract": "MyGovernor",
      "addressRef": "governor",
      "functionName": "setVotingDelay",
      "signature": "setVotingDelay(uint256)",
      "abi": "function setVotingDelay(uint256 newVotingDelay)",
      "description": "Change the number of blocks between proposal creation and voting start.",
      "payable": false,
      "inputs": [
        {
          "name": "newVotingDelay",
          "type": "uint256",
          "semantic": "block-count"
        }
      ],
      "riskProfile": {
        "flatWeight": 25,
        "category": "governance-parameter"
      },
      "analysisHints": [
        "Compare the new voting delay with the current governor.votingDelay value. Shorter delays reduce reaction time; longer delays slow governance."
      ]
    },
    {
