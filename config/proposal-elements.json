      "id": "factory.deployContract",
      "label": "CREATE2 Contract Deployment",
      "contract": "DAOContractFactory",
      "addressRef": "contractFactory",
      "functionName": "deployContract",
      "signature": "deployContract(bytes,bytes32)",
      "abi": "function deployContract(bytes bytecode,bytes32 salt) returns(address)",
      "description": "Deploy contract creation bytecode through the DAO-controlled CREATE2 factory.",
      "payable": false,
      "inputs": [
        {
          "name": "bytecode",
          "type": "bytes",
          "semantic": "creation-bytecode",
