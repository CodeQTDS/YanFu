      "id": "timelock.grantRole",
      "label": "Grant Timelock Role",
      "pack": "Administration Pack",
      "contractType": "access-control",
      "contract": "TimelockController",
      "addressRef": "timelock",
      "functionName": "grantRole",
      "signature": "grantRole(bytes32,address)",
      "abi": "function grantRole(bytes32 role,address account)",
      "description": "Grant an AccessControl role on the TimelockController. Known symbolic roles such as PROPOSER_ROLE, EXECUTOR_ROLE, CANCELLER_ROLE and TIMELOCK_ADMIN_ROLE are resolved deterministically.",
      "payable": false,
      "inputs": [
        {
          "name": "role",
          "type": "bytes32",
          "semantic": "access-role"
        },
        {
          "name": "account",
          "type": "address",
          "semantic": "account"
        }
      ],
      "riskProfile": {
        "flatWeight": 50,
        "category": "access-control"
      },
      "analysisHints": [
        "Role grants change authority. Identify the role, account and resulting governance power explicitly. TIMELOCK_ADMIN_ROLE is especially sensitive."
      ]
    },
    {
