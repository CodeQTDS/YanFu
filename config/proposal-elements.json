{
  "version": 2,
  "description": "Configurable governance capabilities available to the AI planner. YanFu groups capabilities into packs and supports macro expansion plus registered contract types.",
  "capabilities": [
    {
      "id": "treasury.transferERC20",
      "label": "Treasury ERC20 Transfer",
      "contract": "Treasury",
      "addressRef": "treasury",
      "functionName": "transferERC20",
      "signature": "transferERC20(address,address,uint256)",
      "abi": "function transferERC20(address token,address to,uint256 amount)",
      "description": "Transfer ERC20 tokens held by the DAO Treasury to one recipient.",
      "payable": false,
      "inputs": [
        {
          "name": "token",
          "type": "address",
          "semantic": "token-address",
          "defaultRef": "token"
        },
        {
          "name": "to",
          "type": "address",
          "semantic": "recipient"
        },
        {
          "name": "amount",
          "type": "uint256",
          "semantic": "token-amount",
          "decimals": 18
        }
      ],
      "riskProfile": {
        "flatWeight": 10,
        "category": "treasury-transfer"
      },
      "pack": "Treasury Pack",
      "contractType": "treasury",
      "analysisHints": [
        "Transfer ERC20 assets from the DAO Treasury. Compare the requested amount with current Treasury balance and verify the recipient."
      ]
    },
    {
      "id": "treasury.batchTransferERC20",
      "label": "Treasury Batch ERC20 Transfer",
      "contract": "Treasury",
      "addressRef": "treasury",
      "functionName": "batchTransferERC20",
      "signature": "batchTransferERC20(address,address[],uint256[])",
      "abi": "function batchTransferERC20(address token,address[] recipients,uint256[] amounts)",
      "description": "Transfer one ERC20 token held by the DAO Treasury to multiple recipients atomically.",
      "payable": false,
      "inputs": [
        {
          "name": "token",
          "type": "address",
          "semantic": "token-address",
          "defaultRef": "token"
        },
        {
          "name": "recipients",
          "type": "address[]",
          "semantic": "recipient-list"
        },
        {
          "name": "amounts",
          "type": "uint256[]",
          "semantic": "token-amount-list",
          "decimals": 18
        }
      ],
      "validation": {
        "equalLength": [
          [
            "recipients",
            "amounts"
          ]
        ],
        "minArrayLength": {
          "recipients": 1,
          "amounts": 1
        },
        "maxArrayLength": {
          "recipients": 50,
          "amounts": 50
        }
      },
      "riskProfile": {
        "itemArgument": "recipients",
        "weightPerItem": 10,
        "maxWeight": 60,
        "category": "treasury-transfer"
      },
      "pack": "Treasury Pack",
      "contractType": "treasury",
      "analysisHints": [
        "Batch ERC20 Treasury payment. Check recipient/amount alignment, aggregate outflow and current Treasury balance."
      ]
    },
    {
      "id": "treasury.transferETH",
      "label": "Treasury ETH Transfer",
      "contract": "Treasury",
      "addressRef": "treasury",
      "functionName": "transferETH",
      "signature": "transferETH(address,uint256)",
      "abi": "function transferETH(address payable to,uint256 amount)",
      "description": "Transfer native ETH held by the DAO Treasury to one recipient.",
      "payable": false,
      "inputs": [
        {
          "name": "to",
          "type": "address",
          "semantic": "recipient"
        },
        {
          "name": "amount",
          "type": "uint256",
          "semantic": "ether-amount"
        }
      ],
      "riskProfile": {
        "flatWeight": 20,
        "category": "treasury-transfer"
      },
      "pack": "Treasury Pack",
      "contractType": "treasury",
      "analysisHints": [
        "Transfer native ETH from the DAO Treasury. Compare outflow with Treasury ETH balance."
      ]
    },
    {
      "id": "treasury.batchTransferETH",
      "label": "Treasury Batch ETH Transfer",
      "pack": "Treasury Pack",
      "contractType": "treasury",
      "contract": "Treasury",
      "addressRef": "treasury",
      "functionName": "batchTransferETH",
      "signature": "batchTransferETH(address[],uint256[])",
      "description": "Atomically send native ETH from the DAO Treasury to multiple recipients in one Treasury call. If any recipient transfer fails, the entire batch transaction reverts.",
      "payable": false,
      "inputs": [
        {
          "name": "recipients",
          "type": "address[]",
          "semantic": "recipient-list"
        },
        {
          "name": "amounts",
          "type": "uint256[]",
          "semantic": "ether-amount-list"
        }
      ],
      "validation": {
        "equalLength": [
          [
            "recipients",
            "amounts"
          ]
        ],
        "minArrayLength": {
          "recipients": 1,
          "amounts": 1
        },
        "maxArrayLength": {
          "recipients": 50,
          "amounts": 50
        }
      },
      "riskProfile": {
        "itemArgument": "recipients",
        "weightPerItem": 20,
        "maxWeight": 80,
        "category": "treasury-transfer"
      },
      "analysisHints": [
        "Atomic Treasury batch ETH transfer. The Treasury contract checks batch size, equal array lengths and total available ETH before sending.",
        "Because all recipient sends occur in one EVM call, any failed recipient causes the complete batch to revert, including earlier sends in the same batch."
      ],
      "abi": "function batchTransferETH(address[] recipients,uint256[] amounts)"
    },
    {
