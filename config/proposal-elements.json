      "inputs": [
        {
          "name": "role",
          "type": "bytes32",
          "semantic": "access-role"
        },
        {
          "name": "account",
          "type": "address",
          "semantic": "account"
        }
      ],
      "riskProfile": {
        "flatWeight": 45,
        "category": "access-control"
      },
      "analysisHints": [
